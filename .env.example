# ─────────────────────────────────────────────
# AI QA Agent Platform — Environment Variables
# ─────────────────────────────────────────────

## App
APP_NAME=AI QA Agent Platform
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-in-production
LOG_LEVEL=DEBUG

## Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_RELOAD=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_qa_platform
REDIS_URL=redis://localhost:6379/0

## Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WEBSOCKET_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_URL=http://localhost:3000

## AI Orchestrator
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=
LLM_PROVIDER=openai
LLM_RATE_LIMIT_RPM=60
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_FACTOR=2.0
EMBEDDING_MODEL=text-embedding-3-small

## Agent Framework
AGENT_TEMP_DIR=/tmp/ai_qa_agents
AGENT_MAX_STEPS=50
AGENT_DEFAULT_TIMEOUT=300
AGENT_LOG_LEVEL=INFO

## Playwright
PLAYWRIGHT_BROWSER=chromium
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_BASE_URL=http://localhost:3000
PLAYWRIGHT_TIMEOUT=30000
PLAYWRIGHT_RETRIES=2
PLAYWRIGHT_WORKERS=4

## API Testing
API_TEST_BASE_URL=http://localhost:8000
API_TEST_TIMEOUT=30000
API_TEST_RETRIES=2

## Prompt Manager
PROMPT_STORE_BACKEND=file
PROMPT_CACHE_TTL=3600
PROMPT_VERSIONING_ENABLED=true

## Logging
LOGGING_DRIVER=json
LOGGING_ELASTICSEARCH_URL=
LOGGING_ELASTICSEARCH_INDEX=ai-qa-logs
SENTRY_DSN=

## Database (if separate from DATABASE_URL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

## Celery / Workers
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1
CELERY_TASK_TRACK_STARTED=true

## Docker
DOCKER_NETWORK=ai_qa_network
DOCKER_REGISTRY=

## Observability
OTEL_SERVICE_NAME=ai-qa-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_ENABLED=false
