# ── LLM Provider ─────────────────────────
LLM_PROVIDER=openai

# ── OpenAI ───────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2
OPENAI_MAX_TOKENS=4096

# ── Anthropic ────────────────────────────
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TEMPERATURE=0.2
ANTHROPIC_MAX_TOKENS=4096

# ── Azure OpenAI ─────────────────────────
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_DEPLOYMENT=

# ── Retry ────────────────────────────────
LLM_RETRY_MAX_ATTEMPTS=3
LLM_RETRY_BACKOFF_FACTOR=2.0
LLM_RETRY_MIN_WAIT=1.0
LLM_RETRY_MAX_WAIT=30.0

# ── Rate Limiting ────────────────────────
LLM_RATE_LIMIT_RPM=60
LLM_CONCURRENT_LIMIT=5

# ── Tokens ───────────────────────────────
LLM_TOKEN_LIMIT=128000
LLM_OUTPUT_TOKEN_LIMIT=4096
ENABLE_TOKEN_TRACKING=true
TOKEN_LOG_PATH=logs/token_usage.jsonl

# ── Logging ──────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json
